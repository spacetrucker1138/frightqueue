# Rename to refresh.yml to enable nightly data refresh once the repo exists.
name: Refresh game data
on: { schedule: [{ cron: "17 9 * * *" }], workflow_dispatch: {} }
permissions: { contents: write }
jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: python3 scripts/refresh_games.py --per-source 12 && python3 scripts/build.py
      - run: |
          git config user.name "fright-queue-bot"; git config user.email "actions@users.noreply.github.com"
          git add -A && git commit -m "Refresh game data" || echo "no changes"; git push
